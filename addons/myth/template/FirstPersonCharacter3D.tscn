[sub_resource type="GDScript" id="GDScript_j2q5q"]
script/source = "extends Label

func _ready() -> void:
	hide()

func _on_interaction_focus_changed(new_focus: Interactable) -> void:
	visible = new_focus != null
	if new_focus:
		text = new_focus.text
"

