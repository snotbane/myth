[sub_resource type="GDScript" id="GDScript_higry"]
script/source = "extends ResourceNodeExternal

func _ready() -> void:
	super._ready()
	
	resource = SystemPrefs.inst
	path = resource.resource_path
"

[sub_resource type="GDScript" id="GDScript_wxvyr"]
script/source = "extends PropertyMapper

static var system_prefs_node: ResourceNodeExternal

func create_save_sync_binding(from: Node, save_prop_name: String, from_prop_name: String = \"child_value\") -> PropertySyncer:
	return (
		PropertySyncer.new(self)
			.add_connection_push(
				NodePath(\":resource:\" + save_prop_name + \"_changed\"),
				NodePath(\":resource:\" + save_prop_name),
				system_prefs_node
			)
			.add_connection_pull(
				NodePath(\":\" + from_prop_name + \"_changed\"),
				NodePath(\":\" + from_prop_name),
				from
			)
	)

func _create_map() -> void:
	system_prefs_node = Global.find(&\"system_prefs\")
	
	map = [
		create_save_sync_binding(%window_mode, \"window_mode\"),
		create_save_sync_binding(%ui_scale, \"window_ui_scale\"),
		create_save_sync_binding(%resolution_percent, \"render_resolution_percent\"),
		create_save_sync_binding(%upscaling_mode, \"render_upscaling_mode\"),
		create_save_sync_binding(%upscaling_sharpness, \"render_upscaling_sharpness\"),
		create_save_sync_binding(%vsync, \"render_vsync\"),
		create_save_sync_binding(%msaa, \"render_msaa\"),
		create_save_sync_binding(%ssaa, \"render_ssaa\"),
		create_save_sync_binding(%taa, \"render_taa\"),
		
		create_save_sync_binding(%input_binder_manager, \"input_bindings\", \"input_bindings\")
	]
"

