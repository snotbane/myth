[sub_resource type="GDScript" id="GDScript_t3340"]
script/source = "extends ResourceNodeExternal

func _ready() -> void:
	super._ready()
	
	if resource == null:
		resource = SystemPrefs.new()
	
	assert(resource is SystemPrefs)
	resource.populate(self)
"

