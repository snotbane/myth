; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Myth"
config/tags=PackedStringArray("plugin")
run/main_scene="uid://bguh2b4spvwp3"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="uid://ba0bv6xuey8bo"

[audio]

buses/default_bus_layout="uid://bcqh7hsfew7e2"

[autoload]

myth="*uid://b887s2xasmaur"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[editor]

naming/node_name_num_separator=2
naming/node_name_casing=2
naming/scene_name_casing=1
naming/script_name_casing=1

[editor_plugins]

enabled=PackedStringArray("res://addons/myth/script/base/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "gray",
"res://addons/myth/asset/": "red",
"res://addons/myth/script/": "blue"
}

